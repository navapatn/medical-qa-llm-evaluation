{
  "condition": "qwen_extensions_250_v1",
  "description": "A preregistered stratified 250-question extension pilot covering information ablation, abstention, balanced answer position, and independent candidate verification.",
  "n_shots": 5,
  "system_prompt": "As a healthcare professional, provide an expert response to each question. Exactly one answer option is the most correct.",
  "selection_seed": 20260716,
  "max_requests": 2660,
  "max_cost_usd": 5.0,
  "max_workers": 12,
  "progress_every": 100,
  "baseline_run_dir": "runs/openrouter_deepseek_v4_pro_qwen37_full_k1",
  "providers": {
    "openrouter": {
      "protocol": "openai_chat",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "auth_style": "bearer",
      "timeout_seconds": 90,
      "max_retries": 2,
      "extra_headers": {
        "X-Title": "CellPress medical QA extension study"
      }
    }
  },
  "models": [
    {
      "label": "Qwen 3.7 Plus (OpenRouter)",
      "provider": "openrouter",
      "model": "qwen/qwen3.7-plus",
      "temperature": 0.5,
      "input_price_per_million": 0.32,
      "output_price_per_million": 1.28
    }
  ],
  "datasets": [
    {
      "name": "MedQA-USMLE",
      "path": "data/MedQA-USMLE/test.jsonl",
      "shots_path": "repo://medical_reasoning/assets/medqa_usmle_5shot.json",
      "shot_selection": "head",
      "extension_sample_size": 115
    },
    {
      "name": "MedMCQA",
      "path": "data/MedMCQA/validation.jsonl",
      "shots_path": "data/MedMCQA/train.jsonl",
      "shot_filter_percentiles": [50, 90],
      "shot_selection": "per_example",
      "sample_size": 1000,
      "selection_method": "legacy_numpy",
      "selection_seed": 0,
      "extension_sample_size": 90
    },
    {
      "name": "PubMedQA",
      "path": "data/PubMedQA/test.json",
      "shots_path": "data/PubMedQA/train.json",
      "shot_filter_percentiles": [50, 90],
      "shot_selection": "per_example",
      "extension_sample_size": 45
    }
  ],
  "variants": [
    "choices_to_question",
    "generative_no_choices",
    "idk_answerable",
    "idk_unanswerable",
    "choice_rotation",
    "candidate_verification"
  ]
}
