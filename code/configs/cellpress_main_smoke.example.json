{
  "condition": "five_shot_cot_local_extract",
  "system_prompt": "As a healthcare professional, provide an expert response to each question. Exactly one answer option is the most correct.",
  "n_shots": 5,
  "sample_counts": [1],
  "estimated_input_tokens": 3000,
  "estimated_output_tokens": 350,
  "max_requests": 6,
  "max_cost_usd": 0.25,
  "progress_every": 1,
  "max_consecutive_errors": 3,
  "providers": {
    "openrouter": {
      "protocol": "openai_chat",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "auth_style": "bearer",
      "timeout_seconds": 180,
      "max_retries": 4,
      "extra_headers": {
        "X-Title": "CellPress medical reasoning replication"
      }
    },
    "foundry_openai": {
      "protocol": "openai_chat",
      "base_url": "https://YOUR-RESOURCE.openai.azure.com/openai/v1",
      "base_url_env": "FOUNDRY_OPENAI_BASE_URL",
      "api_key_env": "FOUNDRY_API_KEY",
      "auth_style": "api-key",
      "timeout_seconds": 180,
      "max_retries": 4
    },
    "foundry_claude": {
      "protocol": "anthropic_messages",
      "base_url": "https://YOUR-RESOURCE.services.ai.azure.com/anthropic",
      "base_url_env": "FOUNDRY_ANTHROPIC_BASE_URL",
      "api_key_env": "FOUNDRY_API_KEY",
      "auth_style": "x-api-key",
      "timeout_seconds": 180,
      "max_retries": 4,
      "extra_headers": {
        "anthropic-version": "2023-06-01"
      }
    }
  },
  "models": [
    {
      "label": "DeepSeek V4 Flash (OpenRouter)",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
      "temperature": 0.5,
      "max_tokens": 512,
      "input_price_per_million": 0.09,
      "output_price_per_million": 0.18,
      "enabled": true
    },
    {
      "label": "Foundry deployment smoke test",
      "provider": "foundry_openai",
      "model": "REPLACE_WITH_YOUR_DEPLOYMENT_NAME",
      "temperature": 0.5,
      "max_tokens": 512,
      "input_price_per_million": 0,
      "output_price_per_million": 0,
      "enabled": false
    },
    {
      "label": "Foundry Claude smoke test",
      "provider": "foundry_claude",
      "model": "REPLACE_WITH_YOUR_CLAUDE_DEPLOYMENT_NAME",
      "temperature": 0.5,
      "max_tokens": 512,
      "input_price_per_million": 0,
      "output_price_per_million": 0,
      "enabled": false
    }
  ],
  "datasets": [
    {
      "name": "MedQA-USMLE",
      "path": "data/MedQA-USMLE/test.jsonl",
      "shots_path": "repo://medical_reasoning/assets/medqa_usmle_5shot.json",
      "shot_selection": "head",
      "selection_method": "head",
      "max_examples": 2
    },
    {
      "name": "MedMCQA",
      "path": "data/MedMCQA/validation.jsonl",
      "shots_path": "data/MedMCQA/train.jsonl",
      "shot_selection": "head",
      "selection_method": "head",
      "max_examples": 2
    },
    {
      "name": "PubMedQA",
      "path": "data/PubMedQA/test.json",
      "shots_path": "data/PubMedQA/train.json",
      "shot_selection": "head",
      "selection_method": "head",
      "max_examples": 2
    }
  ]
}
